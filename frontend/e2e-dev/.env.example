# Copy this file to .env (same directory) for local runs of
# `npm run test:e2e:dev` -- never commit the real .env, it holds a real
# database credential (see root .gitignore's bare ".env" rule).

# The dev database's connection string -- used only to run the local
# `flask --app wsgi e2e-verify-token <email>` CLI command against it (see
# fixtures.ts's readRemoteVerifyToken), never sent anywhere else.
E2E_REMOTE_DATABASE_URL=

# Override only if the deployed dev URLs ever change.
# E2E_DEV_BASE_URL=https://yarnboard-dev.morkar9696.workers.dev
# E2E_DEV_API_BASE_URL=https://yarnboard-dev-api.onrender.com
